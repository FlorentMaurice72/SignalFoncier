{
  "mcpServers": {
    "perplexity": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@perplexity-ai/mcp-server@1.3.0"],
      "env": {
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY:-injected-by-proxy}"
      }
    },
    "firecrawl": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "firecrawl-mcp@3.40.0"],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY:-fc-injected-by-proxy}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.85",
        "--headless",
        "--isolated",
        "--no-sandbox",
        "--executable-path",
        "${PLAYWRIGHT_CHROMIUM_PATH:-/opt/pw-browsers/chromium}"
      ]
    },
    "composio": {
      "type": "http",
      "url": "${COMPOSIO_MCP_URL:-https://backend.composio.dev/v3/mcp}",
      "headers": {
        "x-api-key": "${COMPOSIO_API_KEY:-injected-by-proxy}"
      }
    }
  }
}
